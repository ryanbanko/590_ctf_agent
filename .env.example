# Copy to .env and fill values from your Langfuse project's API Keys settings.
# Use the base URL for the region hosting your project.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Duke gateway key. Host-only; never copied to the solver or traced.
LITELLM_TOKEN=

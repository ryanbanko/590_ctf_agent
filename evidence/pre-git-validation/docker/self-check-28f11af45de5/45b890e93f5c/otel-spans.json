        "langfuse.observation.output": "{\"stdout\": \"{\\\"angr\\\": \\\"9.2.213\\\", \\\"symbolic_result\\\": 7}\\n\", \"stderr\": \"\", \"exit_code\": 0, \"timed_out\": false, \"truncated\": false, \"output_bytes\": 42}"
    },
